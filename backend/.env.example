# =============================================================================
#  Configuración del backend — copiar a ".env" (nunca versionar .env)
#  database/bootstrap/bootstrap.ps1 completa automáticamente las URLs de BD.
# =============================================================================

# development | test | production
ENVIRONMENT=development

# --- Base de datos --------------------------------------------------------------
# Rol de la APLICACIÓN (privilegios mínimos: DML según tabla)
DATABASE_URL=postgresql+psycopg://topico_app:CAMBIAR@localhost:5432/topico_csj
# Rol PROPIETARIO del esquema: solo para migraciones (alembic) y backups
DATABASE_MIGRATION_URL=postgresql+psycopg://topico_owner:CAMBIAR@localhost:5432/topico_csj

# Base de datos de PRUEBAS (se destruye y recrea al ejecutar pytest)
TEST_DATABASE_URL=postgresql+psycopg://topico_app:CAMBIAR@localhost:5432/topico_csj_test
TEST_DATABASE_MIGRATION_URL=postgresql+psycopg://topico_owner:CAMBIAR@localhost:5432/topico_csj_test

# --- Seguridad ----------------------------------------------------------------
# Secreto para firmar los tokens (mínimo 32 caracteres; OBLIGATORIO en producción).
# Generar con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO
ACCESS_TOKEN_MINUTES=15
# Orígenes permitidos (solo desarrollo; en producción frontend y API comparten origen)
CORS_ORIGINS=http://localhost:5173
# Número de proxies inversos de confianza delante del backend (IIS/Caddy/Nginx = 1)
TRUSTED_PROXY_COUNT=0
# Cookies "Secure" (por defecto: solo en producción; requiere HTTPS)
# COOKIE_SECURE=true
# Documentación OpenAPI en /api/v1/docs (por defecto: deshabilitada en producción)
# DOCS_ENABLED=false

# --- Logs técnicos ----------------------------------------------------------------
LOG_LEVEL=INFO
# LOG_DIR=logs
LOG_RETENTION_DAYS=90

# --- Correo -----------------------------------------------------------------------
# smtp | console (desarrollo: muestra el correo en el log) | file (guarda .eml) | disabled
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Tópico de Salud CSJ Lima <topico@pj.gob.pe>
NOTIFICATIONS_WORKER_ENABLED=true

# --- Aplicación ---------------------------------------------------------------------
# URL de la consulta pública del turno (se incluye en los correos)
PUBLIC_APP_URL=
MAX_UPLOAD_MB=10
