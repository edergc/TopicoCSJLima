# =============================================================================
#  Configuración del backend — copiar a ".env" (nunca versionar .env)
#  database/bootstrap/bootstrap.ps1 completa automáticamente las URLs de BD.
# =============================================================================

# development | test | production
ENVIRONMENT=development

# --- Base de datos --------------------------------------------------------------
# Rol de la APLICACIÓN (privilegios mínimos: DML según tabla)
DATABASE_URL=postgresql+psycopg://topico_app:CAMBIAR@localhost:5432/topico_csj
# Rol PROPIETARIO del esquema: solo para migraciones (alembic) y backups
DATABASE_MIGRATION_URL=postgresql+psycopg://topico_owner:CAMBIAR@localhost:5432/topico_csj

# Base de datos de PRUEBAS (se destruye y recrea al ejecutar pytest)
TEST_DATABASE_URL=postgresql+psycopg://topico_app:CAMBIAR@localhost:5432/topico_csj_test
TEST_DATABASE_MIGRATION_URL=postgresql+psycopg://topico_owner:CAMBIAR@localhost:5432/topico_csj_test
